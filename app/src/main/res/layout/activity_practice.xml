<?xml version="1.0" encoding="utf-8"?>
<!--
    练习 / 运动打卡界面。
    题目类模块：四选一或填空；运动模块：显示动作任务 + 完成按钮。
    样式可随意调整，但带 id 的控件不要删除。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/kgPageBg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="24dp">

    <!-- 顶部：返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBack"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/practice_back"
            android:textColor="?attr/kgBrand" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="?attr/kgBrandDark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- 难度档切换 -->
    <LinearLayout
        android:id="@+id/difficultyRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEasy"
            style="@style/PracticeDiffChip"
            android:text="@string/diff_easy" />

        <Button
            android:id="@+id/btnMedium"
            style="@style/PracticeDiffChip"
            android:text="@string/diff_medium" />

        <Button
            android:id="@+id/btnHard"
            style="@style/PracticeDiffChip"
            android:text="@string/diff_hard" />
    </LinearLayout>

    <!-- 进度 -->
    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/text_sub"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="@color/divider" />

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:textColor="@color/text_main"
        android:textSize="24sp"
        android:lineSpacingExtra="6dp" />

    <!-- 英语题型专用：听标准发音。仅 ENGLISH 题型 + answer 含英文时才可见 -->
    <Button
        android:id="@+id/btnSpeak"
        style="@style/CartoonButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:minWidth="160dp"
        android:text="@string/practice_speak"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- 四选一 -->
    <LinearLayout
        android:id="@+id/optionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- 填空 -->
    <EditText
        android:id="@+id/etAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:autofillHints="no"
        android:gravity="center"
        android:hint="@string/lock_input_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:singleLine="true"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- 运动任务的动作要领 -->
    <TextView
        android:id="@+id/tvTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/text_hint"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minHeight="24dp"
        android:textColor="@color/learning"
        android:textSize="15sp" />

    <!-- 英语题型答对后展示例句（含英文 + 中文翻译）。默认隐藏，仅在答对且该词在例句库里时显示 -->
    <TextView
        android:id="@+id/tvExample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="14dp"
        android:background="@color/subj_english_bg"
        android:textColor="@color/text_main"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSubmit"
        style="@style/CartoonButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/lock_btn_submit" />

</LinearLayout>
