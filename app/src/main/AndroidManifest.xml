<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 读取前台应用，核心能力。需在系统设置中手动授权，无法通过弹窗申请 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11 起查询其他应用需要显式声明，否则应用列表拿不到数据 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".KidsGuardApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.KidsGuard"
        tools:targetApi="34">

        <!-- 主界面：权限引导 + 运行状态 + 家长模式入口 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 全屏答题锁：独立任务栈，不出现在最近任务列表，防止从多任务界面切回游戏 -->
        <activity
            android:name=".lock.LockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:taskAffinity=".lock"
            android:theme="@style/Theme.KidsGuard.Lock" />

        <!-- 家长模式：受 PIN 保护 -->
        <activity
            android:name=".ui.ParentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 应用归类管理 -->
        <activity
            android:name=".ui.AppListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 练习 / 运动打卡 -->
        <activity
            android:name=".ui.PracticeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 我的资料（设置） -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:parentActivityName=".ui.MainActivity" />

        <!-- 奖励小屋 -->
        <activity
            android:name=".ui.RewardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 错题本查看（家长入口，受 PIN 保护：实际靠家长模式层层跳转） -->
        <activity
            android:name=".ui.WrongQuestionsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 核心监测服务 -->
        <service
            android:name=".monitor.UsageMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="统计儿童设备上的应用使用时长，超过设定阈值后弹出学习答题界面" />
        </service>

        <!-- 开机自启 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 设备管理器：用于防止孩子直接卸载（需在系统设置中手动激活） -->
        <receiver
            android:name=".receiver.GuardDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
